# Copy to .env and edit. scripts/start_all.sh loads this file for every service, and
# llama_3p3_api.py also reads it on its own. Values shown are the defaults.

# --- LLM endpoint (required) ------------------------------------------------------
# Any OpenAI-compatible server hosting Llama-3.3-70B-Instruct, for example vLLM:
#   vllm serve meta-llama/Llama-3.3-70B-Instruct --tensor-parallel-size 4 --port 8000
# and then LLM_BASE_URL=http://localhost:8000/v1. The legacy UF_BASE_URL, UF_API_KEY and
# UF_MODEL names are still accepted.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-instruct

# --- Network ----------------------------------------------------------------------
# Interface every HTTP service binds to. The services have no authentication, so keep
# 127.0.0.1 and reach the web UI from another machine with an SSH tunnel.
CRELERI_HOST=127.0.0.1

# Where the services reach each other (base URLs, no trailing slash).
SEGMENTATION_API_URL=http://localhost:17249
GROUNDING_API_URL=http://localhost:12000
LLAMA_API_URL=http://localhost:5003
OBJECT_PROPOSER_URL=http://localhost:17266
QWEN_API_URL=http://localhost:17259
REDIS_URL=redis://localhost:17253/0

# --- Optional ---------------------------------------------------------------------
# D-FINE checkpoint (default: dfine_obj_det/dfine_x_obj365.pth).
# DFINE_CKPT=/path/to/dfine_x_obj365.pth
# Scratch directories of the grounding service (default: private folders in the
# system temp directory, cleaned up after each request).
# SAM2_CACHE_DIR=/scratch/sam2_cache
# GROUNDING_UPLOAD_DIR=/scratch/grounding_uploads
# Pin the Hub code Molmo runs (it loads with trust_remote_code) to a commit.
# MOLMO_REVISION=cab33fb7f1a40091911f81165f8481920621948f

# --- Launcher (scripts/start_all.sh) ------------------------------------------------
# GPUs for each service; the defaults match a 4-GPU machine.
# SEG_GPU=1
# OBJDET_GPU=0
# GROUNDING_GPUS="0 1 2 3"
# Extra qwen2p5_api.py flags, e.g. for a single 80 GB GPU without flash-attn:
# QWEN_ARGS="--max-memory 70GiB --attn-implementation sdpa"
# WEBUI_PORT=5004
# REDIS_PORT=17253
